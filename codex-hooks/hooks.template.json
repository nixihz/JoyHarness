{
  "description": "Xbox / gamepad haptic bridge for Codex runtime states (Joy Harness).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true,
            "statusMessage": "Joy Harness idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true,
            "statusMessage": "Joy Harness busy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true,
            "statusMessage": "Joy Harness waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 3,
            "async": true,
            "statusMessage": "Joy Harness done"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__BRIDGE__\"",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ]
  }
}
