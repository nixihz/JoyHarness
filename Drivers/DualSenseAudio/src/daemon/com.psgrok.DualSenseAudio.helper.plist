<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.psgrok.DualSenseAudio.helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/DualSenseAudio/ds5audiod</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>tech.keli.joyharness.dualsense.controls</key>
        <true/>
        <key>com.psgrok.DualSenseAudio.helper</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Real-time audio pacing: no launchd CPU/IO throttling (coreaudiod itself runs Interactive). -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
